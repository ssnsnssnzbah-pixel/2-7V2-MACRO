    local function normalizeNameToken(value)
        if value == nil then return "" end
        local s = tostring(value):gsub("^%s+", ""):gsub("%s+$", "")
        return string.lower(s)
    end

    local function parseNameList(textValue)
        local list = {}
        if type(textValue) == "table" then
            for _, value in ipairs(textValue) do
                local token = normalizeNameToken(value)
                if token ~= "" then table.insert(list, tostring(value)) end
            end
            return list
        end
        for token in tostring(textValue or ""):gmatch("[^,]+") do
            local clean = token:gsub("^%s+", ""):gsub("%s+$", "")
            if clean ~= "" then table.insert(list, clean) end
        end
        return list
    end

    local function listHasTarget(list, player)
        if type(list) ~= "table" or not player then return false end
        local names = {
            normalizeNameToken(player.Name),
            normalizeNameToken(player.DisplayName),
            normalizeNameToken(player.UserId),
        }
        for _, item in ipairs(list) do
            local token = normalizeNameToken(item)
            for _, name in ipairs(names) do
                if token ~= "" and token == name then return true end
            end
        end
        return false
    end

    local function hasListItems(list)
        return type(list) == "table" and #list > 0
    end

    local function shouldTargetPlayer(player)
        if not player or player == LP then return false end
        local allowed = parseNameList(SS.allowedTargetList)
        local ignored = parseNameList(SS.ignoreTargetList)
        if hasListItems(allowed) and not listHasTarget(allowed, player) then return false end
        if listHasTarget(ignored, player) then return false end
        return true
    end

