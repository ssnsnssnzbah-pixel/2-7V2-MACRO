-- ========================= SAVE FILE HELPERS =========================

local SAVE_FILE = "7v2_settings.json"

local function fileExists(path)
    local ok, result = pcall(function() return isfile(path) end)
    return ok and result
end

local function saveToFile(data)
    pcall(function()
        writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode(data))
    end)
end

local function loadFromFile()
    local ok, result = pcall(function()
        if fileExists(SAVE_FILE) then
            return game:GetService("HttpService"):JSONDecode(readfile(SAVE_FILE))
        end
    end)
    if ok and type(result) == "table" then
        return result
    end
    return nil
end

