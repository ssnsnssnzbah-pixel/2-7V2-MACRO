    local function buildSettingsSnapshot(includeProfiles)
        local toSave = {}

        toSave.macro1Tools = {}
        for _, v in ipairs(m1Tools) do toSave.macro1Tools[#toSave.macro1Tools + 1] = v end

        toSave.macro2Pairs = {}
        for _, v in ipairs(m2Pairs) do
            toSave.macro2Pairs[#toSave.macro2Pairs + 1] = {key = v.getKey(), skin = v.skinBox.Text}
        end

        toSave.macro3Tools = {}
        for _, v in ipairs(m3Tools) do toSave.macro3Tools[#toSave.macro3Tools + 1] = v end
        toSave.macro3Bind = m3GetKey()
        toSave.macro3Delay = getM3Delay()

        toSave.macro4Bind = m4GetKey()
        toSave.macro4Skin = m4SkinBox.Text

        toSave.mobileMode  = mobileMode
        toSave.mobilePositions = ensureTable(SS.mobilePositions)
        toSave.miniMode = SS.miniMode and true or false
        toSave.streamMode = streamModeEnabled
        toSave.hitboxSize  = getHitboxSize()
        toSave.hitboxAlpha = getHitboxAlpha()
        toSave.moveNearestDistance = getMoveNearestDistanceValue()
        toSave.hairGrabInterval = getHairGrabInterval()
        toSave.autoStompThreshold = getStompThreshold()
        toSave.panicKey = getPanicKey()

        toSave.favoriteTools = copyStringList(SS.favoriteTools)
        toSave.favoriteSkins = copyStringList(SS.favoriteSkins)
        toSave.ignoreTargetList = parseNameList(ignoreTargetsBox.Text)
        toSave.allowedTargetList = parseNameList(allowedTargetsBox.Text)

        if includeProfiles ~= false then
            toSave.profiles = ensureTable(SS.profiles)
        end

        return toSave
    end

    local function applySettingsSnapshot(data)
        if type(data) ~= "table" then return false end

        for _, row in ipairs(m1ItemRows) do pcall(function() row:Destroy() end) end
        m1Tools = {}; m1ItemRows = {}
        for _, v in ipairs(copyStringList(data.macro1Tools)) do
            table.insert(m1Tools, v)
            table.insert(m1ItemRows, buildM1Row(v))
        end
        refreshReorderRows(m1ItemRows)

        clearM2Pairs()
        if type(data.macro2Pairs) == "table" and #data.macro2Pairs > 0 then
            for _, pair in ipairs(data.macro2Pairs) do buildM2Pair(pair.key, pair.skin) end
        else
            buildM2Pair()
        end

        for _, row in ipairs(m3ItemRows) do pcall(function() row:Destroy() end) end
        m3Tools = {}; m3ItemRows = {}
        for _, v in ipairs(copyStringList(data.macro3Tools)) do
            table.insert(m3Tools, v)
            table.insert(m3ItemRows, buildM3Row(v))
        end
        refreshReorderRows(m3ItemRows)

        setM3Key(data.macro3Bind or "Q")
        setM4Key(data.macro4Bind or "E")
        setPanicKey(data.panicKey or "P")
        setM3Delay(tonumber(data.macro3Delay) or 0.04)
        m4SkinBox.Text = data.macro4Skin or "Sleek Hoverboard"
        setHitboxSize(tonumber(data.hitboxSize) or 25)
        setHitboxAlpha(tonumber(data.hitboxAlpha) or 0.8)
        setMoveNearestDistance(tonumber(data.moveNearestDistance) or 5)
        setHairGrabInterval(tonumber(data.hairGrabInterval) or 0.08)
        setStompThreshold(tonumber(data.autoStompThreshold) or 15)

        SS.favoriteTools = copyStringList(data.favoriteTools)
        SS.favoriteSkins = copyStringList(data.favoriteSkins)
        SS.ignoreTargetList = parseNameList(data.ignoreTargetList)
        SS.allowedTargetList = parseNameList(data.allowedTargetList)
        allowedTargetsBox.Text = table.concat(SS.allowedTargetList, ", ")
        ignoreTargetsBox.Text = table.concat(SS.ignoreTargetList, ", ")

        applyMobileMode(data.mobileMode and true or false)
        if setMiniMode then setMiniMode(data.miniMode and true or false) end
        applyStreamMode(data.streamMode and true or false)
        return true
    end

