    local function refreshKeyWarnings()
        local usage = {}
        local function addKey(key, label)
            if not key or key == "" then return end
            usage[key] = usage[key] or {}
            table.insert(usage[key], label)
        end
        addKey("B", "Auto Fight")
        addKey("M", "Auto Stomp")
        addKey("N", "Auto Grab")
        addKey(m3GetKey(), "Macro 3")
        addKey(m4GetKey(), "Macro 4")
        addKey(getPanicKey(), "Panic")
        for i, pair in ipairs(m2Pairs) do
            addKey(pair.getKey(), "Macro 2 #" .. tostring(i))
        end

        local conflicts = {}
        for key, labels in pairs(usage) do
            if #labels > 1 then
                table.insert(conflicts, key .. " = " .. table.concat(labels, ", "))
            end
        end
        table.sort(conflicts)
        if #conflicts > 0 then
            keyWarningLbl.Text = "Conflict: " .. table.concat(conflicts, " | ")
            keyWarningLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
        else
            keyWarningLbl.Text = "Keybinds: OK"
            keyWarningLbl.TextColor3 = Color3.fromRGB(100, 255, 160)
        end
    end

    task.spawn(function()
