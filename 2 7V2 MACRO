    }

    local function isProjectilePart(part)
        local low = string.lower(part.Name)
        for _, pat in ipairs(skipNamePatterns) do
            if string.find(low, pat) then return true end
        end
        return false
    end

    local hitboxBodyPartNames = {
        "HumanoidRootPart",
        "LowerTorso",
        "UpperTorso",
        "Torso",
        "Head",
        "LeftUpperArm",
        "RightUpperArm",
        "LeftUpperLeg",
        "RightUpperLeg",
    }

    local function isHitboxBodyPart(char, part)
        if not part or not part:IsA("BasePart") or isProjectilePart(part) then return false end

        local current = part.Parent
        while current and current ~= char do
            if current:IsA("Accessory") or current:IsA("Tool") then
                return false
            end
            current = current.Parent
        end

        return true
    end

    local function findHitboxBodyPart(char)
        for _, partName in ipairs(hitboxBodyPartNames) do
            local part = char:FindFirstChild(partName)
            if isHitboxBodyPart(char, part) then
                return part
            end
        end

        if isHitboxBodyPart(char, char.PrimaryPart) then
            return char.PrimaryPart
        end

        for _, obj in ipairs(char:GetDescendants()) do
            if isHitboxBodyPart(char, obj) then
                return obj
            end
        end

        return nil
    end

    local function getHitboxTargetPart(player)
        if not player or player == LP or not player.Character then return nil end
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return nil end

        return findHitboxBodyPart(player.Character)
    end

    local function partsOverlapWithHitbox(a, b, bExpandSize)
        if not a or not b then return false end
        local sa = a.Size * 0.5
        local sb = (hitboxEnabled and bExpandSize or b.Size) * 0.5
        local d = a.Position - b.Position
        return math.abs(d.X) <= (sa.X + sb.X)
           and math.abs(d.Y) <= (sa.Y + sb.Y)
           and math.abs(d.Z) <= (sa.Z + sb.Z)
    end

    local function restoreHitboxPart(part, orig)
        if part and part.Parent and orig then
            pcall(function()
                part.Size = orig.size
                part.Transparency = orig.transparency
                part.CanCollide = orig.canCollide
            end)
        end
    end

    local function setHitboxes()
        local alpha = getHitboxAlpha()
        local activeParts = {}
        for _, p in ipairs(Players:GetPlayers()) do
            local part = getHitboxTargetPart(p)
            if part then
                activeParts[part] = true
                if not expandOrigSizes[part] then
                    expandOrigSizes[part] = {
                        player = p,
                        size = part.Size,
                        transparency = part.Transparency,
                        canCollide = part.CanCollide,
                    }
                end
                pcall(function()
                    part.Size = expandCurrentSize
                    part.Transparency = alpha
                    part.CanCollide = false
                end)
            end
        end

        for part, orig in pairs(expandOrigSizes) do
            if not activeParts[part] then
                restoreHitboxPart(part, orig)
                expandOrigSizes[part] = nil
            end
        end
    end

    local function restoreHitboxes()
        for part, orig in pairs(expandOrigSizes) do
            restoreHitboxPart(part, orig)
        end
        expandOrigSizes = {}
    end

    local function setHitboxEnabled(state)
