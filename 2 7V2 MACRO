    local function stopLocalMovement()
        local _, root, hum = getLocalCombatParts()
        if hum then
            pcall(function() hum:Move(Vector3.new(0, 0, 0), false) end)
            if root then pcall(function() hum:MoveTo(root.Position) end) end
        end
        if root then
            pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
            pcall(function() root.AssemblyAngularVelocity = Vector3.new(0, 0, 0) end)
        end
    end

    local function triggerPanic()
        panicToken = panicToken + 1
        _G["7v2_PanicAllOff"] = true
        for _, handler in ipairs(panicHandlers) do
