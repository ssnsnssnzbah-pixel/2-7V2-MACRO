    local function addUniqueName(list, name)
        if type(list) ~= "table" or type(name) ~= "string" or name == "" then return end
        local low = string.lower(name)
        for _, existing in ipairs(list) do
            if type(existing) == "string" and string.lower(existing) == low then
                return
            end
        end
        table.insert(list, name)
    end

    local function collectToolNames(primaryFavoriteField)
        local names = {}
        local seen = {}
        local function push(name)
            if type(name) ~= "string" or name == "" then return end
            local low = string.lower(name)
            if not seen[low] then
                seen[low] = true
                table.insert(names, name)
            end
        end

        for _, field in ipairs({primaryFavoriteField, "favoriteTools", "favoriteSkins"}) do
            if field and type(SS[field]) == "table" then
                for _, name in ipairs(SS[field]) do push(name) end
            end
        end

        local containers = {backpack, character}
        for _, container in ipairs(containers) do
            if container then
                for _, obj in ipairs(container:GetChildren()) do
                    if obj:IsA("Tool") then push(obj.Name) end
                end
            end
        end

        table.sort(names, function(a, b) return string.lower(a) < string.lower(b) end)
        return names
    end

