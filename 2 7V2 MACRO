                local relX     = math.clamp(input.Position.X - trackPos, 0, trackW)
                local t        = relX / trackW
                currentVal = minVal + t * (maxVal - minVal)
                updateVisual(currentVal)
                dragging = true
            end
        end)

        task.defer(function() updateVisual(currentVal) end)

        return container, getValue, setValue
    end

