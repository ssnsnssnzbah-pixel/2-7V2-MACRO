        local lastFire = 0
        local lastMovedAt = 0

        local function fireCallback()
            local now = tick()
            if now - lastFire < 0.22 then return end
            if now - lastMovedAt < 0.18 then return end
            lastFire = now
            task.spawn(callback)
        end

        fb.Activated:Connect(function()
            if not moved then
                fireCallback()
            end
        end)

        fb.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
                activeInput   = input
                moved         = false
                dragStart     = input.Position
                startPosition = fb.Position
                dragging      = not mobileLocked
            end
        end)

        fb.InputEnded:Connect(function(input)
            if input == activeInput
            or input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
                activeInput = nil
                if not moved then
                    fireCallback()
                end
                task.delay(0.25, function()
                    if not dragging then moved = false end
                end)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if mobileLocked then return end
            local isActiveTouch = activeInput and input == activeInput
            local isMouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
            if dragging and (isActiveTouch or isMouseMove) and dragStart and startPosition then
                local delta = input.Position - dragStart
                if delta.Magnitude > 12 then
                    moved = true
                    lastMovedAt = tick()
                    fb.Position = UDim2.new(
                        startPosition.X.Scale, startPosition.X.Offset + delta.X,
                        startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
                    )
                    saveMobilePosition(positionKey, fb.Position)
                end
            end
        end)

        return fb
    end

