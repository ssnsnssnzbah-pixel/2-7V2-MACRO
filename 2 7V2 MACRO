    local function getMoveNearestTargetForTick(myRoot)
        if not myRoot then return nil end

        local now = os.clock()
        local cachedRoot = getValidMoveNearestTargetRoot(moveNearestCachedTarget)
        local scanDue = (now - moveNearestLastTargetScan) >= MOVE_NEAREST_TARGET_SCAN_INTERVAL

        if moveNearestLastTargetScan == 0 or scanDue or (moveNearestCachedTarget and not cachedRoot) then
            moveNearestCachedTarget, moveNearestCachedRoot = getNearestTargetToPlayer(myRoot)
            moveNearestLastTargetScan = now
        else
            moveNearestCachedRoot = cachedRoot
        end

        return moveNearestCachedTarget, moveNearestCachedRoot
    end

    local function getMoveNearestDriverPart(myHum, myRoot)
        if myHum and myHum.SeatPart and myHum.SeatPart:IsA("BasePart") then
            return myHum.SeatPart
        end
        return myRoot
    end

    local function lockMoveNearestLook(myRoot, driver, targetRoot)
        if not targetRoot then return end

        if driver then
            local driverFacePoint = Vector3.new(targetRoot.Position.X, driver.Position.Y, targetRoot.Position.Z)
            if (driverFacePoint - driver.Position).Magnitude > 0.1 then
                pcall(function()
                    driver.CFrame = CFrame.lookAt(driver.Position, driverFacePoint)
                end)
            end
        end

        if myRoot then
            local rootFacePoint = Vector3.new(targetRoot.Position.X, myRoot.Position.Y, targetRoot.Position.Z)
            if (rootFacePoint - myRoot.Position).Magnitude > 0.1 then
                pcall(function()
                    myRoot.CFrame = CFrame.lookAt(myRoot.Position, rootFacePoint)
                end)
                pcall(function()
                    myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
            end
        end
    end

    local function driveMoveNearest(myRoot, myHum, targetRoot)
        local driver = getMoveNearestDriverPart(myHum, myRoot)
        if not driver or not targetRoot then return end

        local followDistance = getMoveNearestFollowDistance()
        local offset = driver.Position - targetRoot.Position
        local flatOffset = Vector3.new(offset.X, 0, offset.Z)
        if flatOffset.Magnitude < 0.1 then
            flatOffset = targetRoot.CFrame.LookVector * -1
        end

        local destination = targetRoot.Position + flatOffset.Unit * followDistance
        local flatDestination = Vector3.new(destination.X, driver.Position.Y, destination.Z)
        local toDestination = flatDestination - driver.Position
        local distance = toDestination.Magnitude

        if distance > 0.15 then
            local direction = toDestination.Unit
            local speed = math.clamp(distance * 9, 24, 55)
            pcall(function()
                driver.AssemblyLinearVelocity = Vector3.new(direction.X * speed, driver.AssemblyLinearVelocity.Y, direction.Z * speed)
            end)
            if myRoot and myRoot ~= driver then
                pcall(function()
                    myRoot.AssemblyLinearVelocity = Vector3.new(direction.X * speed, myRoot.AssemblyLinearVelocity.Y, direction.Z * speed)
                end)
            end
        end

        lockMoveNearestLook(myRoot, driver, targetRoot)

        if myHum then
            pcall(function() myHum:MoveTo(destination) end)
        end

        if myHum and (myHum.Sit or myHum.SeatPart) and distance > followDistance + 4 then
            local stepAlpha = math.clamp(distance / 95, 0.04, 0.14)
            local nextPos = driver.Position:Lerp(flatDestination, stepAlpha)
            local facePoint = Vector3.new(targetRoot.Position.X, nextPos.Y, targetRoot.Position.Z)
            pcall(function()
                driver.CFrame = CFrame.lookAt(nextPos, facePoint)
            end)
            lockMoveNearestLook(myRoot, driver, targetRoot)
        end
    end

