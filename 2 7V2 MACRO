    local function refreshReorderRows(rows)
        for i, row in ipairs(rows) do
            if row and row.Parent then
                row.LayoutOrder = i
            end
        end
    end

    local function findReorderRowIndex(rows, row)
        for i, existing in ipairs(rows) do
            if existing == row then return i end
        end
        return nil
    end

    local function getReorderIndexFromY(rows, draggingRow, pointerY)
        local targetIndex = #rows
        for i, row in ipairs(rows) do
            if row ~= draggingRow and row.Parent then
                local middleY = row.AbsolutePosition.Y + row.AbsoluteSize.Y * 0.5
                if pointerY < middleY then
                    return math.clamp(i, 1, #rows)
                end
                targetIndex = i + 1
            end
        end
        return math.clamp(targetIndex, 1, #rows)
    end

    local function moveReorderRow(rows, values, row, targetIndex)
        local fromIndex = findReorderRowIndex(rows, row)
        if not fromIndex or #rows <= 1 then return end
        targetIndex = math.clamp(targetIndex, 1, #rows)
        if fromIndex == targetIndex then return end

        local rowObj = table.remove(rows, fromIndex)
        local valueObj = table.remove(values, fromIndex)
        if targetIndex > #rows + 1 then
            targetIndex = #rows + 1
        end
        table.insert(rows, targetIndex, rowObj)
        table.insert(values, targetIndex, valueObj)
        refreshReorderRows(rows)
    end

    local function attachNameDragReorder(label, row, rows, values)
        local holding = false
        local dragging = false
        local activeInput = nil
        local holdToken = 0
        local normalColor = row.BackgroundColor3

        label.Active = true
        row.Active = true

        local function setDraggingState(state)
            dragging = state and true or false
            row.BackgroundColor3 = dragging and Color3.fromRGB(80, 25, 115) or normalColor
            row.ZIndex = dragging and 6 or 1
            label.ZIndex = dragging and 7 or 1
        end

        local function finishDrag()
            holding = false
            activeInput = nil
            holdToken = holdToken + 1
            setDraggingState(false)
            refreshReorderRows(rows)
        end

        label.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            holding = true
            activeInput = input
            holdToken = holdToken + 1
            local thisToken = holdToken
            task.delay(0.2, function()
                if holding and activeInput == input and holdToken == thisToken then
                    setDraggingState(true)
                end
            end)
        end)

        UserInputService.InputChanged:Connect(function(input)
            if not holding or not dragging then return end
            local isActiveTouch = activeInput and input == activeInput
            local isMouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
            if not isActiveTouch and not isMouseMove then return end
            moveReorderRow(rows, values, row, getReorderIndexFromY(rows, row, input.Position.Y))
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input == activeInput
            or input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                finishDrag()
            end
        end)
    end

