    local function tapCenter()
        if not VIM or not camera then return end
        local vp = camera.ViewportSize
        pcall(function()
            VIM:SendTouchEvent(9, Enum.UserInputState.Begin.Value, vp.X*0.5, vp.Y*0.5)
            task.wait(0.015)
            VIM:SendTouchEvent(9, Enum.UserInputState.End.Value, vp.X*0.5, vp.Y*0.5)
        end)
    end

    local function normalizeToolSearch(value)
        return string.lower(tostring(value or "")):gsub("[^%w]", "")
    end

    local function toolNameMatches(candidate, wanted)
        if type(candidate) ~= "string" or type(wanted) ~= "string" or wanted == "" then return false end
        local c = string.lower(candidate)
        local w = string.lower(wanted)
        if c == w then return true end
        if string.find(c, w, 1, true) or string.find(w, c, 1, true) then return true end
        local cleanCandidate = normalizeToolSearch(candidate)
        local cleanWanted = normalizeToolSearch(wanted)
        return cleanWanted ~= ""
            and (cleanCandidate == cleanWanted
            or string.find(cleanCandidate, cleanWanted, 1, true)
            or string.find(cleanWanted, cleanCandidate, 1, true))
    end

    local function isHoverboardToolName(name)
        local lowerName = string.lower(tostring(name or ""))
        return string.find(lowerName, "hoverboard", 1, true)
            or string.find(lowerName, "loveboard", 1, true)
            or string.find(lowerName, "board", 1, true)
    end

    local function findTool(name)
        if type(name) ~= "string" or name == "" then return nil end
        local containers = {character, backpack}
        for _, container in ipairs(containers) do
            local tool = container and container:FindFirstChild(name)
            if tool and tool:IsA("Tool") then return tool end
        end
        for _, container in ipairs(containers) do
            if container then
                for _, obj in ipairs(container:GetChildren()) do
                    if obj:IsA("Tool") and toolNameMatches(obj.Name, name) then
                        return obj
                    end
                end
            end
        end
        return nil
    end

    local function useMacroTool(name)
        local tool = findTool(name)
        local hum = character and character:FindFirstChildOfClass("Humanoid")
        local isHoverboard = isHoverboardToolName(name) or (tool and isHoverboardToolName(tool.Name))

        if tool and hum then
            hum:EquipTool(tool)
            RunService.RenderStepped:Wait()
            task.wait(0.03)
            if isHoverboard then
                tapCenter()
            else
                pcall(function() tool:Activate() end)
                tapCenter()
            end
            return true, isHoverboard
        end

        tapCenter()
        return false, isHoverboard
    end

    local function executeToolOrder(toolOrder, stepDelay)
        if not character then return end
        stepDelay = stepDelay or 0.06
        local runToken = panicToken
        for i, name in ipairs(toolOrder) do
            if runToken ~= panicToken then return end
            local _, isHoverboard = useMacroTool(name)
            if i == #toolOrder and not isHoverboard then
                task.wait(0.05); tapCenter(); task.wait(0.30)
            end
            task.wait(stepDelay)
            RunService.RenderStepped:Wait()
        end
    end

