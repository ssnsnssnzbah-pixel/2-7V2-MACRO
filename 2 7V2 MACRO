    local function getNearestTargetToPlayer(originPart)
        local _, myRoot = getLocalCombatParts()
        local origin = originPart or myRoot
        if not origin then return nil end

        local originPosition = origin.Position
        local closest, closestRoot, closestDist = nil, nil, math.huge
        for _, player in ipairs(Players:GetPlayers()) do
            if shouldTargetPlayer(player) and player.Character then
                local root = getCharacterRootPart(player.Character)
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (root.Position - originPosition).Magnitude
                    if dist < closestDist then
                        closest = player
                        closestRoot = root
                        closestDist = dist
                    end
                end
            end
        end
        return closest, closestRoot, closestDist
    end

    local function getValidMoveNearestTargetRoot(player)
